  <content>
    <procedure>
      <preliminaryRqmts>
        <reqCondGroup>
          <reqCondNoRef>
            <reqCond>关闭泵进口前和泵出口后所有控制流量的阀门。</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>排尽管道中的液体，如有必要应冲洗干净泵内介质。</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>拆卸影响移走泵芯部件的所有辅助管道和设备。</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>拆卸并取走膜片联轴器部件上的螺栓、间隔轴、叠片组件。</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>现场要有足够的可操作空间满足泵的拆装；还需备有专门拆装泵的平台。</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>现场要具备力矩扳手、千分表、塞尺。</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>现场备有零部件及工具等的储存设施。</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>现场要有相应的运输工具及起吊行车，包括具备各种安装、操作资质的专业人员。</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>现场要具备清洁剂、润滑剂。</reqCond>
          </reqCondNoRef>
        </reqCondGroup>
        <reqSupportEquips>
          <supportEquipDescrGroup>
            <supportEquipDescr>
              <name>扳手</name>
              <identNumber>
                <manufacturerCode>M20</manufacturerCode>
              </identNumber>
              <reqQuantity>1</reqQuantity>
            </supportEquipDescr>
          </supportEquipDescrGroup>
        </reqSupportEquips>
        <reqSupplies>
          <noSupplies>
          </noSupplies>
        </reqSupplies>
        <reqSpares>
          <spareDescrGroup>
            <spareDescr>
              <name>O形圈</name>
              <identNumber>
                <manufacturerCode>JB/ZQ4224 406 X7</manufacturerCode>
              </identNumber>
              <reqQuantity>1</reqQuantity>
            </spareDescr>
          </spareDescrGroup>
        </reqSpares>
        <reqSafety>
          <safetyRqmts>
            <caution>
              <warningAndCautionPara>拆卸时应合理的选用工具和设备，当拆解遇到困难时要先查明原因，采取适当方法解决，不允许猛打乱敲,防止损坏零件和工具。</warningAndCautionPara>
            </caution>
          </safetyRqmts>
        </reqSafety>
      </preliminaryRqmts>
      <mainProcedure>
        <proceduralStep>
          <title>拆除</title>
          <para>
            <sequentialList>
              <listItem>
                <para>松开并拆卸泵体与泵盖的连接螺柱、螺母。</para>
              </listItem>
              <listItem>
                <para>拆卸拆解泵盖、泵体。</para>
              </listItem>
            </sequentialList>
          </para>
        </proceduralStep>
