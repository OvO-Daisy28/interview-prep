            </isolationStep>
            <isolationStep id="id34dd1ced-964f-44bc-aca0-d754a6085dcb">
              <?XEditor_ShapeID id="shape7" ?>
              <action>检查系统</action>
              <isolationStepQuestion>是否发生气蚀</isolationStepQuestion>
              <isolationStepAnswer>
                <yesNoAnswer>
                  <yesAnswer nextActionRefId="id7b430dfb-0966-4490-b6b0-a6d213710356">
                    <?XEditor_PathID id="path33B28E84-0A36-4CA9-A21D-92990093A00B" ?>
