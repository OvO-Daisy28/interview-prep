              <action>更换轴承</action>
            </isolationProcedureEnd>
            <isolationStep id="id17f818be-5412-448d-8985-24eafa149513">
              <?XEditor_ShapeID id="shape6" ?>
              <action>检查管道</action>
              <isolationStepQuestion>是否固定支撑</isolationStepQuestion>
              <isolationStepAnswer>
                <yesNoAnswer>
                  <yesAnswer nextActionRefId="id34dd1ced-964f-44bc-aca0-d754a6085dcb">
                    <?XEditor_PathID id="pathFA45AAD4-71C8-4E0F-AF9A-C97255716A25" ?>
