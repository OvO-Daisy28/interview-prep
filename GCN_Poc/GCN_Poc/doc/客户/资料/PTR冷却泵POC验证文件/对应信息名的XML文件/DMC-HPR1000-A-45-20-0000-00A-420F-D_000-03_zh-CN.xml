              <isolationStepAnswer>
                <yesNoAnswer>
                  <yesAnswer nextActionRefId="idb838ecaf-3090-40c1-aee8-94e7a1a7a53c">
                    <?XEditor_PathID id="path69DCA07F-0BED-4AAF-8645-1A39514F740A" ?>
