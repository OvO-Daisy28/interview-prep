  <content>
    <procedure>
      <preliminaryRqmts>
        <reqCondGroup>
          <reqCondNoRef>
            <reqCond>现场要有足够的可操作空间满足泵的拆装；还需备有专门拆装泵的平台。</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>现场要具备力矩扳手、千分表、塞尺。</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>现场备有零部件及工具等的储存设施。</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>现场要有相应的运输工具及起吊行车，包括具备各种安装、操作资质的专业人员。</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>现场要具备清洁剂、润滑剂。</reqCond>
          </reqCondNoRef>
        </reqCondGroup>
        <reqSupportEquips>
          <supportEquipDescrGroup>
            <supportEquipDescr>
              <name>手动拉拔器</name>
              <identNumber>
                <manufacturerCode>QB/T5537（规格CSQ-300）</manufacturerCode>
              </identNumber>
              <reqQuantity>1</reqQuantity>
            </supportEquipDescr>
            <supportEquipDescr>
              <name>勾扳手</name>
              <identNumber>
                <manufacturerCode>JB/ZQ4624/(A110-115)</manufacturerCode>
              </identNumber>
              <reqQuantity>1</reqQuantity>
            </supportEquipDescr>
            <supportEquipDescr>
              <name>扳手</name>
              <identNumber>
                <manufacturerCode>M16、M20</manufacturerCode>
              </identNumber>
              <reqQuantity>1</reqQuantity>
            </supportEquipDescr>
          </supportEquipDescrGroup>
        </reqSupportEquips>
        <reqSupplies>
          <noSupplies>
          </noSupplies>
        </reqSupplies>
        <reqSpares>
          <spareDescrGroup>
            <spareDescr>
              <name>O形圈</name>
              <identNumber>
                <manufacturerCode>JB/ZQ4224 200 X3.1</manufacturerCode>
              </identNumber>
              <reqQuantity>1</reqQuantity>
            </spareDescr>
            <spareDescr>
              <name>O形圈</name>
              <identNumber>
