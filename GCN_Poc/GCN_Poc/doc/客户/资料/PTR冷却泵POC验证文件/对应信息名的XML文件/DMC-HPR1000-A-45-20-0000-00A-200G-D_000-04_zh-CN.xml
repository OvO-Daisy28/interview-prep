              </identNumber>
              <reqQuantity>2</reqQuantity>
            </spareDescr>
          </spareDescrGroup>
        </reqSpares>
        <reqSafety>
          <safetyRqmts>
            <caution>
              <warningAndCautionPara>端面密封面不允许有明显的径向划痕或损伤，径向密封面不允许有明显的轴向划痕或损伤。叶轮，密封套等倒角处必须用金相砂纸清角，去毛刺。</warningAndCautionPara>
            </caution>
          </safetyRqmts>
        </reqSafety>
      </preliminaryRqmts>
      <mainProcedure>
        <proceduralStep>
          <title>拆除</title>
          <para>
            <sequentialList>
              <listItem>
                <para>拆卸叶轮螺母、止动垫片，取出叶轮。</para>
              </listItem>
              <listItem>
                <para>拆卸托架与泵盖间的连接紧固件，取下泵盖。</para>
              </listItem>
            </sequentialList>
          </para>
        </proceduralStep>
        <figure>
